    pub fn from_string(s: string) -> (Self, bool) { string_to_bool(s) }
    pub fn from_string_or(s: string, default: Self) -> Self {
        let (v, err) = bool::from_string(s);
        if err { default } else { v }
    }
}

// @lang
impl string {
    pub fn to_string(self) -> string { self }
    pub fn from_string(s: string) -> string { s }

    pub fn len(self) -> usize { str_len(self) as usize }
    pub fn is_empty(self) -> bool { self.len() == 0 as usize }
    pub fn to_lower(self) -> string { to_lower(self) }
}

// @lang
impl () {
    pub fn to_string(self) -> string { "()" }
    pub fn from_string(s: string) { }
}