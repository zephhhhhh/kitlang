// @lang
impl i8 {
    pub fn to_string(self) -> string { i64_to_string(self as i64) }
    pub fn from_string(s: string) -> (Self, bool) {
        let result = string_to_i64(s);
        (result.0 as Self, result.1)
    }
    pub fn from_string_or(s: string, default: Self) -> Self {
        let (v, err) = i8::from_string(s);
        if err { default } else { v }
    }

    pub fn sqrt(self) -> Self { i64_sqrt(self as i64) as Self }
    pub fn abs(self) -> Self { i64_abs(self as i64) as Self }
}
