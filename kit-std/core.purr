// @lang
impl i8 { 
    pub fn to_string(self) -> string { i64_to_string(self as i64) }
    pub fn from_string(s: string) -> i8 { string_to_i64(s) as i8 }
    pub fn sqrt(self) -> i8 { i64_sqrt(self as i64) as i8 }
    pub fn abs(self) -> i8 { i64_abs(self as i64) as i8 }
}
