// @lang
impl bool {
    pub fn to_string(self) -> string { bool_to_string(self) }
    pub fn from_string(s: string) -> bool { string_to_bool(s) }
}

// @lang
impl string {
    pub fn to_string(self) -> string { self }
    pub fn from_string(s: string) -> string { s }
}

// @lang
impl () {
    pub fn to_string(self) -> string { "()" }
    pub fn from_string(s: string) { }
}